# Database
POSTGRES_DB=romex
POSTGRES_USER=romex
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend (Django)
DJANGO_SECRET_KEY=una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# States and municipalities come from INEGI's web service (the default is the real one).
# Without internet: python manage.py inegi_falso, and INEGI_API_URL=http://localhost:8777/wscatgeo/v2
# INEGI_API_URL=https://gaia.inegi.org.mx/wscatgeo/v2
# INEGI_TIMEOUT=8

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL data directory (avoids the "directory is not empty" initdb error)
PGDATA=/var/lib/postgresql/data/pgdata
